# Copy to .env and fill in. Everything is optional — sources without keys work out of the box.
# Used by both `node server.js` and `wrangler dev`. For the deployed Worker, set these with
# `npx wrangler secret put <NAME>` instead (never commit them).

# Cloudflare Radar (free). Enables: attack corridors on the globe, L7/L3 target & origin
# heat layers, DDoS vectors, web-attack categories, targeted industries, attack volume
# trends and internet-outage alerts.
# Create at https://dash.cloudflare.com/profile/api-tokens -> Create Token -> Custom token ->
# Permissions: Account > Radar > Read
# (Named RADAR_API_TOKEN, not CLOUDFLARE_API_TOKEN, because Wrangler would otherwise
#  mistake it for its own deploy credentials.)
RADAR_API_TOKEN=

# Contact address sent in the User-Agent to SANS ISC, which asks API users to identify themselves.
CONTACT_EMAIL=

# Local server only: where `node server.js` listens (defaults: 127.0.0.1:8080)
# HOST=127.0.0.1
# PORT=8080
